rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection:
    // Anyone can create an order or read an order (for tracking with order ID)
    // Updates are allowed to reflect status changes and payment confirmations
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // App settings collection (UPI ID, Admin credentials, Gateway config, etc.)
    // Shared and synced across all devices
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
