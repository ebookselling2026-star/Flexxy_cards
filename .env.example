# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FAMGATEWAY_API_KEY: FamGateway v2.0 API Key for live UPI payment gateway.
FAMGATEWAY_API_KEY=""

# FAMPAY_UPI_ID: Your official FamPay UPI ID (e.g. yourhandle@fam or 9876543210@fam)
FAMPAY_UPI_ID=""

# HL GAMING FREE FIRE OFFICIAL API:
# For live Free Fire Player UID account verification and in-game nickname lookup.
HL_GAMING_USERUID=""
HL_GAMING_API_KEY=""

# Admin Passcode for /admin portal
ADMIN_PIN="Gaurav3041"
